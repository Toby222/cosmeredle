{
	"compilerOptions": {
		"target": "ESNext",
		"types": ["bun"],
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true,
		"paths": {
			"lib/*": ["./src/lib/*"],
			"client/*": ["./src/client/*"],
			"server/*": ["./src/server/*"],
			"assets/*": ["./src/assets/*"],
			"*": ["./src/*"]
		}
	},
	"include": ["./src", "./build.ts"]
}
