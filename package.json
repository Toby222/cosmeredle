{
	"name": "cosmeredle",
	"version": "2.1.0",
	"author": "Toby",
	"repository": {
		"type": "git",
		"url": "git://git.tobot.dev/toby/cosmeredle.git"
	},
	"main": "server.ts",
	"dependencies": {
		"aberdeen": "^1.13.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"typescript": "^6.0.3",
		"@happy-dom/global-registrator": "^20.9.0",
		"husky": "^9.1.7"
	},
	"bugs": {
		"url": "https://git.tobot.dev/toby/cosmeredle/issues"
	},
	"description": "",
	"homepage": "https://git.tobot.dev/toby/cosmeredle#readme",
	"license": "CC0-1.0",
	"scripts": {
		"fix": "biome lint --write && biome format --write && biome check --write",
		"lint": "biome ci",
		"build": "bun build --compile --minify --production --chunk-naming='[name].[ext]' --asset-naming='[name].[ext]' --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json --format esm ./src/server.ts --outfile cosmeredle --bytecode",
		"start": "bun run ./src/server.ts --production",
		"dev": "bun run --watch ./src/server.ts",
		"prepare": "husky",
		"postinstall": "bun2nix -o cosmeredle.bun.nix"
	}
}
